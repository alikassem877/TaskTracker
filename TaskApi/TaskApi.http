
@TaskApi_HostAddress = http://localhost:5205
@TaskId = 1

### Get all tasks
GET {{TaskApi_HostAddress}}/api/tasks
Accept: application/json

###

### Create a task
POST {{TaskApi_HostAddress}}/api/tasks
Content-Type: application/json

{
  "title": "Learn Entity Framework Core",
  "priority": 2
}

###

### Get a task by ID
GET {{TaskApi_HostAddress}}/api/tasks/{{TaskId}}
Accept: application/json

###

### Complete a task
PUT {{TaskApi_HostAddress}}/api/tasks/{{TaskId}}/complete

###

### Delete a task
DELETE {{TaskApi_HostAddress}}/api/tasks/{{TaskId}}

###

### Test: Empty title (should return 400)
POST {{TaskApi_HostAddress}}/api/tasks
Content-Type: application/json

{
  "title": "",
  "priority": 2
}

###

### Test: Title exceeds 100 characters (should return 400)
POST {{TaskApi_HostAddress}}/api/tasks
Content-Type: application/json

{
  "title": "This is a very long task title that exceeds the maximum allowed length of one hundred characters and should fail validation",
  "priority": 2
}

###

### Test: Invalid priority (should return 400)
POST {{TaskApi_HostAddress}}/api/tasks
Content-Type: application/json

{
  "title": "Invalid priority test",
  "priority": 99
}

###

### Test: Get nonexistent task (should return 404)
GET {{TaskApi_HostAddress}}/api/tasks/999

###

### Test: Complete nonexistent task (should return 404)
PUT {{TaskApi_HostAddress}}/api/tasks/999/complete

###

### Test: Delete nonexistent task (should return 404)
DELETE {{TaskApi_HostAddress}}/api/tasks/999
