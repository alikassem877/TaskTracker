
@TaskApi_HostAddress = http://localhost:5205
@TaskId = 105
@email = testuser4@example.com
@password = aaaassssd

### Login (send this first)
# @name login
POST {{TaskApi_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###

### Get all tasks
GET {{TaskApi_HostAddress}}/api/tasks
Authorization: Bearer {{login.response.body.token}}
Accept: application/json

###

### Create a task
# @name createTask
POST {{TaskApi_HostAddress}}/api/tasks
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "Learn Entity Framework Core",
  "priority": 2
}

###

### Get a task by ID
GET {{TaskApi_HostAddress}}/api/tasks/{{TaskId}}
Authorization: Bearer {{login.response.body.token}}
Accept: application/json

###

### Complete a task
PUT {{TaskApi_HostAddress}}/api/tasks/{{TaskId}}/complete
Authorization: Bearer {{login.response.body.token}}

###

### Delete a task
DELETE {{TaskApi_HostAddress}}/api/tasks/{{TaskId}}
Authorization: Bearer {{login.response.body.token}}

###

### Test: Empty title (400)
POST {{TaskApi_HostAddress}}/api/tasks
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "",
  "priority": 2
}

###

### Test: Title exceeds 100 characters (400)
POST {{TaskApi_HostAddress}}/api/tasks
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "This is a very long task title that exceeds the maximum allowed length of one hundred characters and should fail validation",
  "priority": 2
}

###

### Test: Invalid priority (400)
POST {{TaskApi_HostAddress}}/api/tasks
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "title": "Invalid priority test",
  "priority": 99
}

###

### Test: Get nonexistent task (404)
GET {{TaskApi_HostAddress}}/api/tasks/999999
Authorization: Bearer {{login.response.body.token}}

###

### Test: Complete nonexistent task (404)
PUT {{TaskApi_HostAddress}}/api/tasks/999999/complete
Authorization: Bearer {{login.response.body.token}}

###

### Test: Delete nonexistent task (404)
DELETE {{TaskApi_HostAddress}}/api/tasks/999999
Authorization: Bearer {{login.response.body.token}}

###

### Test: Unauthenticated request (401)
GET {{TaskApi_HostAddress}}/api/tasks
